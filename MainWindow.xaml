<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Буфер" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="16,4,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <TextBlock x:Name="SearchPlaceholder" Text="Поиск по истории" Foreground="#6E7584" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1"/>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#6E7584" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1"/>
        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="36,10,10,10"/>
      </Grid>

      <WrapPanel x:Name="Filters" Grid.Row="1" Margin="0,12,0,4"/>

      <Grid Grid.Row="2">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
          <StackPanel x:Name="ItemsPanel" Margin="0,0,6,0"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="20,0,20,40">
          <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="36" Foreground="#2FB36E" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyTitle" Text="Скопируй что-нибудь" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
          <TextBlock x:Name="EmptyText" Text="Всё, что ты копируешь — текст, ссылки, картинки, файлы — будет сохраняться здесь"
                     Foreground="#8B92A0" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Background="#1C1F26" CornerRadius="14" Padding="14,12" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Background="#262A33" CornerRadius="7" Padding="8,3" Margin="0,0,10,0">
              <TextBlock Text="Ctrl + Shift + V" FontFamily="Consolas" FontSize="12"/>
            </Border>
            <TextBlock Text="быстрая вставка из истории в любом окне" Foreground="#AEB4C0" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Style="{StaticResource Separator}" Margin="0,10"/>
          <CheckBox x:Name="SwAutostart" Style="{StaticResource Switch}">
            <TextBlock Text="Запускать вместе с Windows"/>
          </CheckBox>
          <Grid Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0">
              <Run x:Name="CountRun" Text=""/>
              <Run Text=" · Буфер"/>
              <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
            </TextBlock>
            <Button x:Name="ClearBtn" Style="{StaticResource SecondaryBtn}" Background="#262A33" Padding="10,6"
                    HorizontalAlignment="Right" Content="Очистить историю"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
